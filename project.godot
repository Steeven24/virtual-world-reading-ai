; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="virtual-world-reading-ai"
run/main_scene="res://scenes/UI/login_screen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SceneManager="*uid://3hsd1gb4gr66"
ReadingAPI="*res://scripts/Global/reading_api.gd"
AuthManager="*res://scripts/Global/auth_manager.gd"
Ajustes="*res://scripts/Global/ajustes.gd"
Pantalla="*res://scripts/Global/pantalla.gd"
Tipografia="*res://scripts/Global/tipografia.gd"
Sonido="*res://scripts/Global/sonido.gd"
GameSession="*res://scripts/Global/game_session.gd"
AchievementToast="*res://scripts/Global/achievement_toast.gd"
NpcChatAPI="*res://scripts/Global/npc_chat_api.gd"
LobbyReturnHandler="*res://scenes/Global/lobby_return_handler.tscn"
ProgressionManager="*res://scenes/Global/progression_manager.tscn"
ReadingProgressManager="*res://scripts/Global/reading_progress_manager.gd"
MedalImageLoader="*res://scripts/Global/medal_image_loader.gd"
ComicLibrary="*res://scripts/Global/comic_library.gd"
ProfileHUD="*res://scripts/UI/profile_hud.gd"
ObjectivesHUD="*res://scripts/UI/objectives_hud.gd"
GuiaDestino="*res://scripts/Global/guia_destino.gd"
SessionGuard="*res://scripts/Global/session_guard.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/initial_position_type=0
window/size/resizable=false
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/custom_font="res://fonts/fuente_juego.tres"

